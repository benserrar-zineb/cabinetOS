{
  "name": "cabinetos",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "lint": "eslint apps packages",
    "format:check": "prettier --check apps packages --config packages/config/prettier.config.js",
    "check:architecture": "pnpm --filter @cabinetos/api run check:architecture",
    "test": "pnpm --filter @cabinetos/api run test && pnpm --filter @cabinetos/web run test",
    "db:check": "pnpm --filter @cabinetos/api run db:check",
    "build": "pnpm --filter @cabinetos/api run build && pnpm --filter @cabinetos/web run build",
    "test:isolation": "pnpm --filter @cabinetos/api run test:isolation"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.17.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "dependency-cruiser": "^18.1.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^7.1.0",
    "prettier": "^3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}